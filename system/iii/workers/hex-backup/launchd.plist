<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for the hex iii worker (label: com.hex.iii-backup).
  Rendered by system/scripts/iii-engine.sh (install) which substitutes:
    NODE_PLACEHOLDER   -> resolved node binary (command -v node)
    INDEX_PLACEHOLDER  -> $HEX_DIR/.hex/iii/workers/<name>/index.js
    WORKDIR_PLACEHOLDER-> $HEX_DIR/.hex/iii/workers/<name>
    HEXDIR_PLACEHOLDER -> $HEX_DIR
    HEXBIN_PLACEHOLDER -> $HEX_DIR/.hex/bin/hex
    PATH_PLACEHOLDER   -> runtime PATH
    LOG_PLACEHOLDER    -> $HEX_DIR/.hex/logs/<label>.log
  Bootstrap (manual, gui-domain): launchctl bootstrap gui/$(id -u) <rendered plist>
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hex.iii-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>NODE_PLACEHOLDER</string>
        <string>INDEX_PLACEHOLDER</string>
    </array>
    <key>WorkingDirectory</key>
    <string>WORKDIR_PLACEHOLDER</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HEX_DIR</key>
        <string>HEXDIR_PLACEHOLDER</string>
        <key>HEX_BIN</key>
        <string>HEXBIN_PLACEHOLDER</string>
        <key>III_URL</key>
        <string>ws://127.0.0.1:49134</string>
        <key>PATH</key>
        <string>PATH_PLACEHOLDER</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>LOG_PLACEHOLDER</string>
    <key>StandardErrorPath</key>
    <string>LOG_PLACEHOLDER</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
