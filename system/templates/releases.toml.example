# releases.toml — additional repo profiles for the hex release engine.
#
# Drop this file at $HEX_DIR/.hex/config/releases.toml to teach
# `hex release cut` (and the oss-releaser worker) about repos beyond the
# built-in hex-foundation profile. Without this file, only hex-foundation
# is releasable; any other repo is refused with an error listing the known
# profiles.
#
# A repo matches a profile if EITHER rule hits:
#   match_remote — substring of `git remote get-url origin`
#                  (use the "owner/repo" form: it matches both the https
#                  and ssh remote URL shapes)
#   match_dir    — exact toplevel directory name
#
# See: system/harness/src/release.rs module docs for the full schema.

# -----------------------------------------------------------------------------
# Example: a Rust repo released with `just` gates and no GitHub release.
# Gates run in order via `sh -c` from the repo root; all must pass before
# the release ceremony proceeds.
# -----------------------------------------------------------------------------
[[profiles]]
name = "boi"
match_remote = "YOUR-GITHUB-USERNAME/boi"
# match_dir = "boi"            # alternative: match by directory name
gates = [
  { name = "just-check", command = "just check" },
  { name = "lint-scripts", command = "just lint-scripts" },
]
# Version files the ceremony bumps. kind: "plain" (whole file is the version
# string, default) | "cargo-toml" (rewrites the `version = "…"` line only).
version_files = [
  { path = "Cargo.toml", kind = "cargo-toml" },
]
# Run after the bump so lockfiles update; a failing build reverts the bump.
build_command = "cargo build --release"
tag_prefix = "v"               # default "v"
gh_release = false             # default false — no `gh release create`
main_branch = "main"           # default
develop_branch = "develop"     # default

# -----------------------------------------------------------------------------
# Watcher fields — consumed by the oss-releaser worker's branch watch.
#
# repo_dir — absolute path to a local clone of this repo on the host running
#            the harness. The watcher polls origin and runs the release
#            ceremony from this checkout. REQUIRED when watch = true and must
#            be absolute — the loader refuses the file otherwise (S6, no
#            silent skips). The real path is instance config: set it only in
#            the deployed $HEX_DIR/.hex/config/releases.toml; never embed
#            personal home paths in foundation source.
# watch    — opt this profile in (true) or out (false, the default) of the
#            branch watch. Watching is strictly opt-in; a profile with a
#            configured repo_dir opts back out with watch = false. The manual
#            `release.requested` event path is unaffected by this flag.
#            A watched repo also gets develop-sync on every tick: the
#            releaser owns pushing base branches, so when the local develop
#            is strictly ahead of origin it is pushed (same guarded push
#            path as the ceremony); a diverged develop is alerted loudly and
#            NEVER auto-resolved (no pull/rebase/reset/force-push); in-sync
#            or behind-only does nothing.
# -----------------------------------------------------------------------------
repo_dir = "/absolute/path/to/local/clone"   # REQUIRED when watch = true
watch = true                                 # default false — opt-in

# -----------------------------------------------------------------------------
# The built-in hex-foundation profile is configured the same way: an entry
# named "hex-foundation" may set ONLY the watcher fields. Its gates, version
# files, and branches are pinned in code — overriding one of those here is
# refused loudly at load.
# -----------------------------------------------------------------------------
# [[profiles]]
# name = "hex-foundation"
# repo_dir = "/absolute/path/to/local/clone/of/hex-foundation"
# watch = true
