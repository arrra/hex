<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GENERIC iii worker launchd template. iii-engine.sh (install) renders one copy
  per worker config (.hex/iii/workers/<name>.yaml), substituting:
    LABEL_PLACEHOLDER  -> com.hex.iii-<name>
    HEXBIN_PLACEHOLDER -> $HEX_DIR/.hex/bin/hex
    CONFIG_PLACEHOLDER -> abs path to the worker's YAML config
    HEXDIR_PLACEHOLDER -> $HEX_DIR
    PATH_PLACEHOLDER   -> runtime PATH
    LOG_PLACEHOLDER    -> $HEX_DIR/.hex/logs/<label>.log
  No node, no per-worker binary — the hex binary is the worker host.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>LABEL_PLACEHOLDER</string>
    <key>ProgramArguments</key>
    <array>
        <string>HEXBIN_PLACEHOLDER</string>
        <string>iii</string>
        <string>worker</string>
        <string>run</string>
        <string>CONFIG_PLACEHOLDER</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HEX_DIR</key>
        <string>HEXDIR_PLACEHOLDER</string>
        <key>III_URL</key>
        <string>ws://127.0.0.1:49134</string>
        <key>PATH</key>
        <string>PATH_PLACEHOLDER</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>LOG_PLACEHOLDER</string>
    <key>StandardErrorPath</key>
    <string>LOG_PLACEHOLDER</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
