<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for the hex iii engine (label: com.hex.iii-engine).
  Rendered by system/scripts/iii-engine.sh (install) which substitutes:
    III_BIN_PLACEHOLDER  -> resolved `iii` binary path (command -v iii)
    CONFIG_PLACEHOLDER   -> $HEX_DIR/.hex/iii/iii-config.yaml
    WORKDIR_PLACEHOLDER  -> $HEX_DIR/.hex/iii (engine cwd; ./data lives here)
    LOG_PLACEHOLDER      -> $HEX_DIR/.hex/logs/iii-engine.log
  Bootstrap (manual, gui-domain): launchctl bootstrap gui/$(id -u) <this rendered plist>
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hex.iii-engine</string>

    <key>ProgramArguments</key>
    <array>
        <string>III_BIN_PLACEHOLDER</string>
        <string>--config</string>
        <string>CONFIG_PLACEHOLDER</string>
        <string>--no-update-check</string>
    </array>

    <key>WorkingDirectory</key>
    <string>WORKDIR_PLACEHOLDER</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>LOG_PLACEHOLDER</string>
    <key>StandardErrorPath</key>
    <string>LOG_PLACEHOLDER</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
