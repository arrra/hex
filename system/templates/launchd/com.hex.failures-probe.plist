<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.hex.failures-probe — out-of-process liveness probe for the hex harness.

  `hex failures probe` checks events.db freshness (last row < 45 min old) and
  that com.hex.harness is loaded in launchd. It alerts via osascript DIRECTLY
  (never via the in-harness alert path) because the harness/events.db may be
  the broken thing. It MUST run from its own launchd job, never from inside
  the harness — an in-harness probe dies with the thing it watches.

  Install (instance-side deploy op; substitute placeholders first — the repo
  sanitize gate forbids hardcoded /Users/ paths in templates):
    HEXBIN_PLACEHOLDER -> $HEX_DIR/.hex/bin/hex
    HEXDIR_PLACEHOLDER -> $HEX_DIR
    LOG_PLACEHOLDER    -> $HEX_DIR/.hex/logs/failures-probe.log
  then:
    cp <rendered>.plist ~/Library/LaunchAgents/com.hex.failures-probe.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hex.failures-probe.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hex.failures-probe</string>
  <key>ProgramArguments</key>
  <array>
    <string>HEXBIN_PLACEHOLDER</string>
    <string>failures</string>
    <string>probe</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>HEX_DIR</key><string>HEXDIR_PLACEHOLDER</string></dict>
  <key>StartInterval</key><integer>1800</integer>
  <key>StandardErrorPath</key><string>LOG_PLACEHOLDER</string>
</dict>
</plist>
