<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Code-intelligence nightly indexer template (SPEC-A1 §7).

  Per-user gui LaunchAgent (install to ~/Library/LaunchAgents), one copy PER
  REGISTERED WORKSPACE. Runs `cq index` nightly at 02:30 so agent queries the
  next day hit a fresh generation.

  Manual install in A1 (hex-upgrade wiring is a follow-up). Substitute the
  placeholders before loading — see docs/code-intel.md "Scheduling with
  launchd" for the exact steps:

    __CQ_BIN__     -> absolute path to the cq binary
                      (e.g. /Users/you/github.com/mrap/hex-foundation/target/release/cq)
    __WORKSPACE__  -> absolute path of the registered workspace's primary
                      checkout (the same path you passed to `cq register`)
    __HOME__       -> your home directory (for the log paths; launchd does not
                      expand ~)

  If you index multiple workspaces, give each copy a unique Label suffix
  (com.hex.codeintel-indexer.<name>) and filename to match.

  Logs land under ~/.codeintel/logs/. `cq index` takes its own flock, so an
  overlapping manual run is skipped visibly ({"skipped":"emit-in-flight"}),
  never doubled.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hex.codeintel-indexer</string>
    <key>ProgramArguments</key>
    <array>
        <string>__CQ_BIN__</string>
        <string>index</string>
        <string>--workspace</string>
        <string>__WORKSPACE__</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <!-- rust-analyzer must be reachable; cq doctor verifies the same PATH. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.codeintel/logs/com.hex.codeintel-indexer.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.codeintel/logs/com.hex.codeintel-indexer.log</string>
    <key>ProcessType</key>
    <string>Background</string>
    <!-- Emit is CPU/RAM heavy (rust-analyzer over the whole workspace);
         Nice keeps it out of the way of interactive work if it ever runs
         while you're at the keyboard. -->
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
