<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hex harness launchd template (spec S5yw25n5y; LaunchDaemon form 2026-06-05).

  This is a SYSTEM LaunchDaemon (installed to /Library/LaunchDaemons), NOT a
  per-user gui LaunchAgent: `UserName` runs it as the user (correct file
  ownership, not root) while surviving logout / no-login-session / session churn.
  A gui/<uid> agent dies on Log Out; this does not. (FileVault still requires one
  manual disk unlock per reboot — by design; the daemon survives session churn
  while the machine is up, not unattended reboots.)

  `hex harness start` renders this template by substituting:
    HEXBIN_PLACEHOLDER -> $HEX_DIR/.hex/bin/hex
    HEXDIR_PLACEHOLDER -> $HEX_DIR
    USER_PLACEHOLDER   -> the target user (SUDO_USER/USER) — runs as that user
    PATH_PLACEHOLDER   -> runtime PATH (homebrew prepended)
    LOG_PLACEHOLDER    -> $HEX_DIR/.hex/logs/com.hex.harness.log

  The harness is a single-process drain-aware host for the typed Rust workers
  in `hex::workers::registry()`. The hidden `hex harness serve` entry IS the
  long-running process — launchd invokes it; humans use `start|stop|status`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hex.harness</string>
    <key>UserName</key>
    <string>USER_PLACEHOLDER</string>
    <key>ProgramArguments</key>
    <array>
        <string>HEXBIN_PLACEHOLDER</string>
        <string>harness</string>
        <string>serve</string>
    </array>
    <key>WorkingDirectory</key>
    <string>HEXDIR_PLACEHOLDER</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HEX_DIR</key>
        <string>HEXDIR_PLACEHOLDER</string>
        <key>III_URL</key>
        <string>ws://127.0.0.1:49134</string>
        <key>PATH</key>
        <string>PATH_PLACEHOLDER</string>
        <!-- The folded-in backup worker uploads via the `gws` Drive API; gws's
             default keyring is the macOS login keychain, unreachable from a
             headless daemon (→ "Platform secure storage failure"). Force the
             file keyring backend so backups work with no GUI session. -->
        <key>GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND</key>
        <string>file</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>LOG_PLACEHOLDER</string>
    <key>StandardErrorPath</key>
    <string>LOG_PLACEHOLDER</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
