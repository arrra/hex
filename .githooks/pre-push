#!/bin/sh
# pre-push shim — all branch logic lives in `hex git-guard pre-push`.
hex_bin="$(git rev-parse --show-toplevel)/target/release/hex"
if [ ! -x "$hex_bin" ]; then hex_bin="$(command -v hex || true)"; fi
if [ -z "$hex_bin" ]; then
  echo "WARN: hex binary not found — skipping git-guard pre-push" >&2
  exit 0
fi
exec "$hex_bin" git-guard pre-push "$@"
